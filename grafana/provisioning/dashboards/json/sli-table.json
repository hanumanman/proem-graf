  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "${machine}",
      "description": "One row per minute. A blank cell means that signal did not report in that minute. Load % of SWL is hoist load divided by hoist SWL.",
      "datasource": {
        "type": "influxdb",
        "uid": "PD260F78FC8D02CC3"
      },
      "gridPos": {
        "h": 20,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "PD260F78FC8D02CC3"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  date_bin(INTERVAL '1 minute', time) AS time,\n  MAX(CASE WHEN signal_key = 'value.Hoist.Load' THEN value END) AS hoist_load,\n  MAX(CASE WHEN signal_key = 'value.Hoist.Safe.Working.Load' THEN value END) AS hoist_swl,\n  MAX(CASE WHEN signal_key = 'value.Hoist.Load' THEN value END)\n    / NULLIF(MAX(CASE WHEN signal_key = 'value.Hoist.Safe.Working.Load' THEN value END), 0) * 100 AS load_pct,\n  MAX(CASE WHEN signal_key = 'value.Boom.Angle' THEN value END) AS boom_angle,\n  MAX(CASE WHEN signal_key = 'value.Wind.Speed' THEN value END) AS wind,\n  MAX(CASE WHEN signal_key = 'value.SLI.Bypass.State' THEN value END) AS sli_bypass,\n  MAX(CASE WHEN signal_key = 'value.SLI.Motion.Cut' THEN value END) AS sli_motion_cut,\n  MAX(CASE WHEN signal_key = 'value.SLI.Communication.State' THEN value END) AS sli_comm\nFROM signal\nWHERE $__timeFilter(time)\n  AND machine_name = '${machine}'\n  AND signal_key IN (\n    'value.Hoist.Load',\n    'value.Hoist.Safe.Working.Load',\n    'value.Boom.Angle',\n    'value.Wind.Speed',\n    'value.SLI.Bypass.State',\n    'value.SLI.Motion.Cut',\n    'value.SLI.Communication.State'\n  )\nGROUP BY 1\nORDER BY 1 DESC"
        }
      ],
